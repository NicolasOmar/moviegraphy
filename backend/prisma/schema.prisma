// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id       String     @id @unique
  name     String?    @db.VarChar(25)
  username String     @unique @db.VarChar(50)
  email    String     @unique @db.VarChar(50)
  password String     @db.Text
  tokens   Sessions[]
  movies   Movies[]
  genres   Genres[]
}

model Sessions {
  id        String   @id @default(uuid())
  token     String   @unique @db.Text
  userId    String
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Countries {
  id           String  @id @unique
  name         String  @unique
  officialName String? @unique
  alpha2       String  @unique
  alpha3       String  @unique
}

model Genders {
  id     String   @id @unique
  name   String   @unique
  actors Actors[]
}

model Movies {
  countryMade String
  description String?          @db.VarChar(300)
  id          String           @id @unique
  name        String           @db.VarChar(150)
  releaseYear Int
  userId      String
  user        Users            @relation(fields: [userId], references: [id], onDelete: Cascade)
  genres      GenresOnMovies[]
}

model Genres {
  id     String           @id @unique
  name   String           @unique @db.VarChar(100)
  userId String
  user   Users            @relation(fields: [userId], references: [id], onDelete: Cascade)
  movies GenresOnMovies[]
}

model GenresOnMovies {
  movie      Movies   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId    String
  genre      Genres   @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId    String
  assignedAt DateTime @default(now())

  @@id([movieId, genreId])
}

model Actors {
  id       String    @id @unique
  name     String    @db.VarChar(100)
  lastName String    @db.VarChar(100)
  bornDate DateTime
  deadDate DateTime?
  genderId String
  gender   Genders   @relation(fields: [genderId], references: [id], onDelete: Cascade)
}
