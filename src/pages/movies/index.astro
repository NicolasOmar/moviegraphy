---
import type { CustomAstroLocals } from '@ts-types/entities'

import { getGenreList } from '@api/genres'
import { getMovieList } from '@api/movies'
import { ReactMovieForm } from '@feature-components/movies/ReactMovieForm'
import { ReactMovieTable } from '@feature-components/movies/ReactMovieTable'
import NavigationLayout from '@layouts/NavigationLayout.astro'
import TwoColumnsLayout from '@layouts/TwoColumnsLayout.astro'

const movieListColumns = [
  {
    dataIndex: 'name',
    key: 'name',
    title: 'Name'
  },
  {
    dataIndex: 'description',
    key: 'description',
    title: 'Description'
  },
  {
    dataIndex: 'releaseYear',
    key: 'releaseYear',
    title: 'Year of release'
  },
  {
    dataIndex: 'countryMade',
    key: 'countryMade',
    title: 'Country'
  }
]

const loggedUserId = (Astro.locals as CustomAstroLocals).loggedUserId
const genreList = await getGenreList(loggedUserId).catch(() => [])
const movieList = await getMovieList(loggedUserId).catch(() => [])
---

<NavigationLayout>
  <TwoColumnsLayout>
    <ReactMovieForm client:visible genreList={genreList} />
    <ReactMovieTable client:visible columns={movieListColumns} dataSource={movieList} />
  </TwoColumnsLayout>
</NavigationLayout>
