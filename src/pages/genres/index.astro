---
import { findGenres } from '@api/genres'
import { ReactGenreForm } from '@components/genres/ReactGenreForm'
import { ReactGenreList } from '@components/genres/ReactGenreList'
import NavigationLayout from '@layouts/NavigationLayout.astro'
import TwoColumnsLayout from '@layouts/TwoColumnsLayout.astro'
import { SESSION_COOKIE_NAME } from '@ts/constants'

const genreListColumns = [
  {
    dataIndex: 'name',
    key: 'name',
    title: 'Name'
  }
]
const sessionToken = Astro.cookies.get(SESSION_COOKIE_NAME)?.value as string
const genreList = await findGenres(sessionToken).catch(() => [])
---

<NavigationLayout>
  <TwoColumnsLayout>
    <ReactGenreForm client:visible />
    <ReactGenreList client:visible columns={genreListColumns} dataSource={genreList} />
  </TwoColumnsLayout>
</NavigationLayout>
