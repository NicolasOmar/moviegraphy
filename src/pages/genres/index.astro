---
import { getGenreList } from '@api/genres'
import { ReactGenrePage } from '@feature-components/genres/ReactGenrePage'
import NavigationLayout from '@layouts/NavigationLayout.astro'
import OneColumnLayout from '@layouts/OneColumnLayout.astro'
import { type CustomAstroLocals } from '@ts-types/entities'

const genreListColumns = [
  {
    dataIndex: 'name',
    key: 'name',
    title: 'Name'
  },
  {
    dataIndex: 'moviesAmount',
    key: 'moviesAmount',
    title: 'N of movies'
  }
]
const loggedUserId = (Astro.locals as CustomAstroLocals).loggedUserId
const genreList = await getGenreList(loggedUserId).catch(() => [])
---

<NavigationLayout>
  <OneColumnLayout>
    <ReactGenrePage client:visible columns={genreListColumns} dataSource={genreList} />
  </OneColumnLayout>
</NavigationLayout>
