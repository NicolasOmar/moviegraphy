---
import { getGenreList } from '@api/genres'
import { ReactGenreForm } from '@components/genres/ReactGenreForm'
import { ReactGenreTable } from '@components/genres/ReactGenreTable'
import NavigationLayout from '@layouts/NavigationLayout.astro'
import TwoColumnsLayout from '@layouts/TwoColumnsLayout.astro'
import { type CustomAstroLocals } from '@ts/entities'

const genreListColumns = [
  {
    dataIndex: 'name',
    key: 'name',
    title: 'Name'
  },
  {
    dataIndex: 'moviesAmount',
    key: 'moviesAmount',
    title: 'N of movies'
  }
]
const loggedUserId = (Astro.locals as CustomAstroLocals).loggedUserId
const genreList = await getGenreList(loggedUserId).catch(() => [])
---

<NavigationLayout>
  <TwoColumnsLayout>
    <ReactGenreForm client:visible />
    <ReactGenreTable client:visible columns={genreListColumns} dataSource={genreList} />
  </TwoColumnsLayout>
</NavigationLayout>
