---
import { ReactPasswordForm } from '@components/users/ReactPasswordForm'
import { ReactUserUpdateForm } from '@components/users/ReactUserUpdateForm'
import NavigationLayout from '@layouts/NavigationLayout.astro'
---

<NavigationLayout>
  <section class="settings_content">
    <ReactPasswordForm client:visible />
    <ReactUserUpdateForm client:visible />
  </section>
</NavigationLayout>

<style>
  section.settings_content {
    display: grid;
    margin: 0 2.5%;
  }
</style>
