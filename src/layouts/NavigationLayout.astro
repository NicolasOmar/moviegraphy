---
import { PAGE_URL } from '@ts/constants'
import { ClientRouter } from 'astro:transitions'

import BaseLayout from './BaseLayout.astro'

const listOfLinks = [
  { label: 'Home', page: PAGE_URL.HOME },
  { label: 'Movies', page: PAGE_URL.MOVIES },
  { label: 'Genres', page: PAGE_URL.GENRES }
]

enum NAVIGATION_LABELS {
  ACCOUNT = 'Account',
  LOGOUT = 'Logout',
  SETTINGS = 'Settings'
}

const currentPath = Astro.url.pathname.replace(/(.+)\/$/, '$1')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width" name="viewport" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <link href="/favicon.ico" rel="icon" />
    <meta content={Astro.generator} name="generator" />
    <title>Moviegraphy</title>

    <ClientRouter />
  </head>
  <BaseLayout>
    <header transition:persist>
      <nav class="nav">
        {
          listOfLinks.map(({ label, page }) => {
            const isActive = currentPath === page

            return (
              <a
                aria-current={isActive ? 'page' : undefined}
                class="nav__link"
                class:list={[{ 'nav__link--active': isActive }]}
                href={page}
              >
                {label}
              </a>
            )
          })
        }
      </nav>

      <section class="dropdown">
        <span aria-controls="account_menu" aria-haspopup="menu" class="dropdown__trigger">
          {NAVIGATION_LABELS.ACCOUNT}
        </span>
        <section class="dropdown__menu" id="account_menu" role="menu">
          <a href={PAGE_URL.USERS_UPDATE} role="menuitem">
            {NAVIGATION_LABELS.SETTINGS}
          </a>
          <a id="logout_link" role="menuitem">
            {NAVIGATION_LABELS.LOGOUT}
          </a>
        </section>
      </section>
    </header>
    <section class="base__content">
      <slot />
    </section>
  </BaseLayout>
</html>

<script>
  import { addMessageToContext } from '@store/messages'
  import { API_METHODS, API_URLS, HTTP_STATUS, PAGE_URL } from '@ts/constants'
  import { fetchWithAuth } from '@ts/helpers'
  import { parseResponseErrorToMessage } from '@ts/parsers'

  const logoutLink = document.getElementById('logout_link')

  if (logoutLink) {
    logoutLink.addEventListener('click', async () => {
      const logOutRespose = await fetchWithAuth(API_URLS.SESSIONS, {
        method: API_METHODS.DELETE
      })

      if (logOutRespose.status !== HTTP_STATUS.OK) {
        const errorMessage = await parseResponseErrorToMessage(logOutRespose)
        addMessageToContext({ content: errorMessage, type: 'error' })
      } else {
        window.location.href = PAGE_URL.HOME
      }
    })
  }
</script>

<style>
  header {
    box-sizing: border-box;
    width: 100%;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    background: #ffffff;
    border-bottom: 1px solid rgba(5, 5, 5, 0.06);
    margin-bottom: 16px;
    font-family:
      -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans',
      sans-serif;
    font-size: 14px;
    line-height: 1.5714285714285714;
  }
  .nav {
    display: flex;
    align-items: center;
    height: 100%;
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    height: 46px;
    padding: 0 16px;
    color: rgba(0, 0, 0, 0.88);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav__link:hover,
  .nav__link--active {
    color: #1677ff;
  }
  .dropdown {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
  }
  .dropdown__trigger {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 16px;
    color: rgba(0, 0, 0, 0.88);
    cursor: pointer;
    border-radius: 6px;
    transition: color 0.2s;
  }
  .dropdown__trigger:hover {
    color: #1677ff;
  }
  .dropdown__menu {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
    flex-direction: column;
    min-width: 120px;
    padding: 4px;
    background: #ffffff;
    border-radius: 8px;
    box-shadow:
      0 6px 16px 0 rgba(0, 0, 0, 0.08),
      0 3px 6px -4px rgba(0, 0, 0, 0.12),
      0 9px 28px 8px rgba(0, 0, 0, 0.05);
  }
  .dropdown:hover .dropdown__menu {
    display: flex;
  }
  .dropdown__menu > a {
    display: block;
    padding: 5px 12px;
    color: rgba(0, 0, 0, 0.88);
    text-decoration: none;
    border-radius: 4px;
    transition: background-color 0.2s;
  }
  .dropdown__menu > a:hover {
    background-color: rgba(0, 0, 0, 0.04);
  }
  .base__content {
    display: grid;
    margin: 0 2.5%;
  }
</style>
