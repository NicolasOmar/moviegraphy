---
import { ReactModal } from '@base-components/ReactModal'
import { ReactNotifications } from '@base-components/ReactNotifications'
import { ReactModalForm } from '@composed-components/ReactModalForm'
import { ClientRouter } from 'astro:transitions'
import '@styles/breakpoints.css'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width" name="viewport" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <link href="/favicon.ico" rel="icon" />
    <meta content={Astro.generator} name="generator" />
    <title>Moviegraphy</title>

    <ClientRouter />
  </head>
  <body>
    <slot />
    <ReactNotifications client:load transition:persist />
    <ReactModal client:load transition:persist />
    <ReactModalForm client:load transition:persist />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    font-family:
      -apple-system, 'system-ui', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans',
      sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji';
  }
</style>
